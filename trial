from flask import Flask,render_template,request
from get_weather_data import get_location_list,api_error_check

app=Flask(__name__)

@app.route("/")
def home():
    return render_template("index.html",is_student=False)
    

@app.route("/about")
def hello():
    return "this is a website backend and I am starter and want to learn some things like this"


@app.route("/search",methods=["POST"])
def search():
    city=request.form.get("city")
    location_list=api_error_check(0,city)

    return render_template("result.html",location_list=location_list)

@app.route("/weather_info",methods=["POST"])
def weather():
    selected_location=request.form.get("location_id")
    location_weather=api_error_check(selected_location,0)
    print(location_weather["current"])

    return render_template("weather.html",location_weather=location_weather)

if __name__ == "__main__":
    app.run(debug=True)