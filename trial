from flask import Flask,render_template,request

app=Flask(__name__)

@app.route("/")
def home():
    user = "crasey guy"
    return render_template("index.html",username=user,is_student=False)
     

@app.route("/about")
def hello():
    return "this is a website backend and I am starter and want to learn some things like this"


@app.route("/search",methods=["POST"])
def search():
    city=request.form.get("city")
    return f"you search for the city : {city} "

if __name__ == "__main__":
    app.run(debug=True)